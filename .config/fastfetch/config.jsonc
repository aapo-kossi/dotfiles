// Load with --load-config examples/2.jsonc
// Note that you must replace the image path to an existing image to display it.

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 2
        }
    },
    "display": {
        "color": {
            "separator": "white"
        },
        "separator": " ",
    },
    "modules": [
        "title",
        {
            "type": "custom",
            "outputColor": "separator",
            "format": "╭───────────────{#33}System{#keys}─────────────────",
            "length": 1
        },
        {
            "type": "host",
            "key": "├󰌢",
            "keyColor": "yellow"
        },
        {
            "type": "os",
            "key": "├󰣇",
            "keyColor": "yellow",
            "format": "{2}"
        },
        {
            "type": "kernel",
            "key": "├",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "├󰏖",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "├",
            "keyColor": "yellow"
        },

        {
            "type": "custom",
            "outputColor": "separator",
            "format": "├────────────────{#34}Look{#keys}──────────────────",
            "length": 1
        },
        {
            "type": "wm",
            "key": "├",
            "keyColor": "blue"
        },
        {
            "type": "lm",
            "key": "├󰧨",
            "keyColor": "blue"
        },
        {
            "type": "theme",
            "key": "├󰉼",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "├",
            "keyColor": "blue"
        },
        {
            "type": "icons",
            "key": "├󰀻",
            "keyColor": "blue"
        },
        {
            "type": "cursor",
            "key": "├󰇀",
            "keyColor": "blue"
        },
        {
            "type": "wallpaper",
            "key": "├󰸉",
            "keyColor": "blue"
        },
        {
            "type": "font",
            "key": "├A",
            "keyColor": "blue"
        },

        {
            "type": "custom",
            "outputColor": "separator",
            "format": "├───────────────{#32}Hardware{#keys}───────────────",
            "length": 1
        },
        {
            "type": "cpu",
            "key": "├󰻠",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "├/",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "├󰑭",
            "keyColor": "green"
        },

        {
            "type": "colors",
            "symbol": "diamond",
            "block": {
                "width": 2,
                "range": [0,7]
            },
            "key": "╰──────────────────────"
        },
    ]
}
