* {
    background-color:      Black;
    text-color:            White;
    border-color:          White;
    font:            "Times New Roman 12";
}

window {
    anchor:     north;
    location:   north;
    width:      100%;
    padding:    4px;
    children:   [ parenbox ];
}


parenbox {
    orientation: vertical;
    children:   [ horibox, listview ];
}

horibox {
    orientation: horizontal;
    children:   [ entry , dummy, boxbox ];
}
// promptbox {
//     orientation: vertical;
//     children:   [ prompt, entry ];
// }
boxbox {
    str: "hello world";
    expand: false;
}
dummy {
    expand: true;

    }

listview {
    layout:     horizontal;
    spacing:    5px;
    lines:      10;
}

entry {
    expand:     false;
    width:      10em;
}

element {
    padding: 0px 2px;
}
element selected {
    background-color: SteelBlue;
}
